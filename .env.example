# APP_URL: The URL where this applet is hosted.
# Used for CORS allowlist and self-referential links.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB (e.g. MongoDB Atlas or local mongod).
# When unset, the server falls back to a local file-backed persistent store in .data/.
MONGODB_URI=""

# CORS_ORIGINS: Optional comma-separated list of additional allowed origins.
CORS_ORIGINS=""
